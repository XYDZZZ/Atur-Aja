# ─────────────────────────────────────────────────
#  AturAja Bot — Environment Variables
#  Copy file ini menjadi .env dan isi nilainya
# ─────────────────────────────────────────────────

# Supabase (dapatkan dari: https://app.supabase.com → Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# PENTING: Gunakan Service Role Key (bukan Anon Key) agar bot bisa membaca
# semua data tanpa batasan RLS. Jaga kerahasiaan key ini!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Timezone server (sesuaikan lokasi kamu)
TZ=Asia/Jakarta
